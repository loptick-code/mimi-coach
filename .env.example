# Cle de chiffrement Fernet pour les tokens Garmin (generee avec: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
FERNET_KEY=changeme-generate-with-fernet

# Cle pour signer les cookies de session FastAPI
SESSION_SECRET=changeme-random-string-32-chars-min

# URL DB (par defaut SQLite local)
DATABASE_URL=sqlite:///./data/app.db

# Comptes créés au démarrage, tous avec les mêmes droits.
COACH_EMAIL=coach@example.com
COACH_PASSWORD=changeme
COACH_NAME=Compte principal
ATHLETE_EMAIL=athlete@example.com
ATHLETE_PASSWORD=changeme
ATHLETE_NAME=Athlète 1

# Compte supplémentaire optionnel. Laisser vide pour ne pas le créer.
ATHLETE2_EMAIL=
ATHLETE2_PASSWORD=
ATHLETE2_NAME=Athlète 2

# Développement local uniquement. Sur Vercel, utiliser DEBUG=false et
# HTTPS_ONLY_COOKIES=true.
DEBUG=true
HTTPS_ONLY_COOKIES=false
